#!/bin/sh

# Suíte completa antes de enviar pro remoto (espelha o CI "Verificações pré-deploy").
# Para pular temporariamente: git push --no-verify

set -e

# Push que só apaga refs remotas (git push origin --delete x) não precisa de testes.
ZERO="0000000000000000000000000000000000000000"
ONLY_DELETES=1
HAS_REFS=0
while read -r local_ref local_sha remote_ref remote_sha; do
  HAS_REFS=1
  if [ "$local_sha" != "$ZERO" ]; then
    ONLY_DELETES=0
  fi
done
if [ "$HAS_REFS" -eq 1 ] && [ "$ONLY_DELETES" -eq 1 ]; then
  echo "pre-push: só deleção de refs remotas, pulando testes."
  exit 0
fi

echo ""
echo "╔══════════════════════════════════════╗"
echo "║         Verificações pré-push        ║"
echo "╚══════════════════════════════════════╝"
echo ""

# 1. Lint do repo inteiro (lint-staged no pre-commit só enxerga os staged)
echo "▶ [1/3] Lint + format (repo inteiro)..."
npx biome check src
echo "✓ Lint passou"
echo ""

# 2. Testes + cobertura
echo "▶ [2/3] Testes com cobertura..."
npm run test:coverage
echo "✓ Testes passaram"
echo ""

# 3. Build
echo "▶ [3/3] Build de produção..."
# NEXT_TURBOPACK_DISABLE=1: Turbopack spawns child processes for PostCSS that fail on
# Windows with exit code 0xc0000142 (DLL init failure). Railway CI runs Linux — unaffected.
NEXT_TURBOPACK_DISABLE=1 npm run build
echo "✓ Build concluído"
echo ""

echo "✅ Todas as verificações passaram. Push liberado."
echo ""
