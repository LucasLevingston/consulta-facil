#!/bin/sh

# Só verificações rápidas. Suíte completa, cobertura e build rodam no pre-push.

set -e

echo ""
echo "╔══════════════════════════════════════╗"
echo "║        Verificações pré-commit       ║"
echo "╚══════════════════════════════════════╝"
echo ""

# 0a. SOLID check
echo "▶ [SOLID] Verificando violações SOLID/SRP..."
sh "$(dirname "$0")/solid-check.sh"
echo "✓ SOLID ok"
echo ""

# 0. Regenerar cliente API (orval) a partir do openapi.json local
echo "▶ [0/2] Gerando integração API (orval)..."
npm run api:generate
git add src/lib/api/generated
echo "✓ Integração API gerada"
echo ""

# 1. Checagem de tipos TypeScript
echo "▶ [1/2] Checagem de tipos (TypeScript)..."
npx tsc --noEmit
echo "✓ Sem erros de tipagem"
echo ""

# 2. Lint + testes relacionados (só nos arquivos staged)
echo "▶ [2/2] Lint + testes relacionados aos arquivos staged..."
npx lint-staged
echo "✓ Lint e testes relacionados passaram"
echo ""

echo "✅ Verificações rápidas passaram. Commit liberado."
echo "   (suíte completa, cobertura e build rodam no pre-push)"
echo ""
